# Pflicht: API-Schluessel von https://console.anthropic.com (niemals im Frontend, nur hier serverseitig)
ANTHROPIC_API_KEY=

# Modell fuer die eigentliche Schadenanalyse. Standard jetzt claude-opus-5 (hoehere
# Analysequalitaet auf Kundenwunsch, teurer als claude-sonnet-5 - siehe README).
ANTHROPIC_MODEL=claude-opus-5

# Modell fuer das Auslesen des Fahrzeugscheins. War bewusst ein guenstigeres Modell
# (claude-haiku-4-5), weil die Aufgabe "einfach" wirkte - echte Tests (02.10.2026) zeigten
# aber zuverlaessig FALSCHE statt nur ungenaue Werte bei kleinem, dichtem Formulartext
# (z.B. Baujahr 2024 als 1984 gelesen, ein Hersteller/Modell durch ein anderes, bekannteres
# ersetzt). Jetzt dasselbe starke Modell wie die Schadenanalyse - fuer ein einzelnes Bild ist
# der Mehrkostenunterschied vernachlaessigbar, Genauigkeit hat hier klar Vorrang.
ANTHROPIC_EXTRACTION_MODEL=claude-opus-5

# Analyse-Aufwand fuer das Fahrzeugschein-Auslesen: low/medium/high/xhigh/max. "high" gibt der
# KI mehr Bedenkzeit vor der Antwort - bei einem einzelnen Bild unkritisch fuer die Laufzeit
# (maxDuration=30 in extract-vehicle/route.ts), aber wichtig fuer die Lesegenauigkeit.
ANTHROPIC_EXTRACTION_EFFORT=high

# Analyse-Aufwand fuer die Schadenanalyse: low/medium/high/xhigh/max. "high" fuehrte bei
# mehreren Fotos zu echten Server-Timeouts (Vercel bricht Funktionen nach 60s hart ab,
# siehe Vorfall 10.09.2026) - "medium" ist deutlich schneller bei weiterhin guter Qualitaet.
# Nur mit Bedacht erhoehen und danach mit mehreren echten Fotos die Laufzeit testen.
ANTHROPIC_EFFORT=medium

# Business-Kalibrierung: Multiplikator auf die von der KI geschaetzte Reparaturkostenspanne,
# um die vom Gutachter beobachtete systematische Unterschaetzung auszugleichen. 3.0 = +200%.
# WICHTIG: Noch nicht anhand echter Vergleichsdaten (Schaetzung vs. tatsaechliche Rechnung)
# verifiziert - siehe README fuer die Empfehlung, das zeitnah nachzuholen.
COST_ESTIMATE_MULTIPLIER=3.0

# Optional: einfache IP-basierte Ratenbegrenzung pro Stunde (siehe README - Hinweis zu Grenzen)
RATE_LIMIT_PER_HOUR=20

# Partner-Apps (z. B. Crash Assist) greifen mit einem API-Schluessel auf /api/analyze zu, siehe docs/PARTNER-API.md.
# Format: name:schluessel, mehrere kommagetrennt, Schluessel mindestens 16 Zeichen (z. B. `openssl rand -hex 24`).
# PARTNER_API_KEYS=crash-assist:SCHLUESSEL
# Limit pro Partner-Schluessel und Stunde (Standard 300):
# RATE_LIMIT_PARTNER_PER_HOUR=300

# Lead-Benachrichtigung per E-Mail: jede Nutzung, bei der jemand seine Kontaktdaten hinterlassen hat,
# schickt eine E-Mail mit Name/Telefon/E-Mail des Kunden. Ohne Konfiguration wird NICHTS versendet und
# der Lead nur ins (kurzlebige) Vercel-Laufzeit-Log geschrieben.
# Empfaenger, mehrere kommagetrennt (Pflicht):
# LEAD_NOTIFY_EMAIL=schaden@witmaier-gutachten.de,weitere@adresse.de
#
# Weg 1 (bevorzugt, kein DNS noetig): SMTP, z. B. ein Gmail-Konto mit App-Passwort
# (Google-Konto -> Sicherheit -> Bestaetigung in zwei Schritten -> App-Passwoerter).
# SMTP_USER=absender@gmail.com
# SMTP_PASSWORD=
# Optional: SMTP_HOST (Standard smtp.gmail.com), SMTP_PORT (Standard 465), SMTP_FROM_NAME (Standard KI-Schadenrechner)
#
# Weg 2: Resend (https://resend.com). Mit onboarding@resend.dev liefert Resend nur an die E-Mail des
# eigenen Kontos - fuer andere Empfaenger eine Domain bei Resend verifizieren.
# RESEND_API_KEY=
# LEAD_FROM_EMAIL="KI-Schadenanalyse <ki@witmaier-gutachten.de>"

# Optionaler Push aufs Handy (ntfy, https://ntfy.sh): ntfy-App installieren und ein LANGES,
# zufaelliges Thema abonnieren (z.B. schaden-ki-x7k29fq81m), dasselbe hier eintragen. Der Push
# enthaelt keine Kontaktdaten. Ohne NTFY_TOPIC wird kein Push gesendet.
# NTFY_TOPIC=
