# Pflicht: API-Schluessel von https://console.anthropic.com (niemals im Frontend, nur hier serverseitig)
ANTHROPIC_API_KEY=

# Optional: Modell wechseln. Standard = claude-sonnet-5 (guenstiger, sehr gute Bildanalyse).
# Fuer maximale Analysequalitaet auf Kosten hoeherer laufender Kosten: claude-opus-5
ANTHROPIC_MODEL=claude-sonnet-5

# Optional: einfache IP-basierte Ratenbegrenzung pro Stunde (siehe README - Hinweis zu Grenzen)
RATE_LIMIT_PER_HOUR=20
