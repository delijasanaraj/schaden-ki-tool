# Pflicht: API-Schluessel von https://console.anthropic.com (niemals im Frontend, nur hier serverseitig)
ANTHROPIC_API_KEY=

# Modell fuer die eigentliche Schadenanalyse. Standard jetzt claude-opus-5 (hoehere
# Analysequalitaet auf Kundenwunsch, teurer als claude-sonnet-5 - siehe README).
ANTHROPIC_MODEL=claude-opus-5

# Schnelles, guenstiges Modell nur fuer das Auslesen des Fahrzeugscheins (einfache Lese-Aufgabe,
# braucht keine hohe Modellstaerke).
ANTHROPIC_EXTRACTION_MODEL=claude-haiku-4-5

# Business-Kalibrierung: Multiplikator auf die von der KI geschaetzte Reparaturkostenspanne,
# um die vom Gutachter (20 Jahre Praxiserfahrung) beobachtete systematische Unterschaetzung
# auszugleichen. 2.0 = +100%. Bei Bedarf anhand echter Vergleichsdaten (Schaetzung vs.
# tatsaechliche Reparaturrechnung) weiter nachjustieren - siehe README.
COST_ESTIMATE_MULTIPLIER=2.0

# Optional: einfache IP-basierte Ratenbegrenzung pro Stunde (siehe README - Hinweis zu Grenzen)
RATE_LIMIT_PER_HOUR=20
